# CivicTwin-R Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# Local macOS/Linux Setup:
#   Run ./scripts/setup.sh (generates randomized .env secrets with chmod 600),
#   or copy this file to .env and populate local secrets manually before start.
#
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── MQTT Broker (TCP port 1883, optional WebSocket 9001) ─────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=civictwin_backend
MQTT_TOPIC_PREFIX=civictwin/v1

# ── InfluxDB 2.x Time-Series Engine (UI/API port 8086) ───────────────────────
# Auto-provisioned into .env by ./scripts/setup.sh for local loopback operation.
INFLUXDB_ENABLED=false
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=civictwin
INFLUXDB_BUCKET=telemetry
INFLUXDB_USERNAME=civictwin
INFLUXDB_PASSWORD=<generate-local-password-via-setup-sh>
INFLUXDB_TOKEN=<generate-local-token-via-setup-sh>

# ── Backend API & Security (FastAPI UI/REST port 8000) ───────────────────────
# Standalone default binds exclusively to loopback (127.0.0.1).
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:1880,http://localhost:1880

# ── Digital Twin & Freshness Parameters ──────────────────────────────────────
TWIN_TIME_STEP_SEC=5
TWIN_DEFAULT_SCENARIO=normal
RANDOM_SEED=42
ENABLE_INTERNAL_SIMULATOR=false
STALE_READING_TIMEOUT_SEC=30.0
OFFLINE_TIMEOUT_SEC=90.0

# ── Persistence Configuration ────────────────────────────────────────────────
# Primary database: SQLite WAL (always available offline); InfluxDB writes concurrently.
STORAGE_BACKEND=sqlite
SQLITE_DB_PATH=data/civictwin.db

# ── Node-RED Operational Dashboard (port 1880) ───────────────────────────────
NODERED_PORT=1880
