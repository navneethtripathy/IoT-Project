# CivicTwin-R Environment Configuration
# Copy this file to .env and fill in actual values

# ── MQTT Broker ──────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=civictwin_backend
MQTT_TOPIC_PREFIX=civictwin/v1

# ── InfluxDB ─────────────────────────────────────────────
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=YOUR_INFLUXDB_TOKEN_HERE
INFLUXDB_ORG=civictwin
INFLUXDB_BUCKET=telemetry
INFLUXDB_ENABLED=false

# ── Backend API ──────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
LOG_LEVEL=INFO

# ── Digital Twin ─────────────────────────────────────────
TWIN_TIME_STEP_SEC=5
TWIN_DEFAULT_SCENARIO=normal
RANDOM_SEED=42

# ── Storage Mode ─────────────────────────────────────────
# Options: influxdb, sqlite, memory
STORAGE_BACKEND=sqlite
SQLITE_DB_PATH=data/civictwin.db

# ── Node-RED ─────────────────────────────────────────────
NODERED_PORT=1880
